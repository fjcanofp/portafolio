---
layout: null
permalink: /search.json
---

[
{% assign searchable =
   site.posts
   | concat: site.units
   | concat: site.modules
   | concat: site.cycles
%}

{% for item in searchable %}

{
  "title":
    {{ item.title | jsonify }},

  "url":
    {{ item.url | relative_url | jsonify }},

  "type":
    {{ item.collection | jsonify }},

  "description":
    {{
      item.description
      | default: item.summary
      | default: item.excerpt
      | strip_html
      | strip_newlines
      | truncate: 240
      | jsonify
    }},

  "content":
    {{
      item.content
      | strip_html
      | strip_newlines
      | truncate: 1500
      | jsonify
    }}
}

{% unless forloop.last %},{% endunless %}

{% endfor %}
]